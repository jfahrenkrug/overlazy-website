---
interface Props {
  text: string;
  class?: string;
}
const { text, class: className = '' } = Astro.props;
---

<span class:list={['kraft-tag', className]}>
  <svg class="kraft-tag__string" viewBox="0 0 24 40" aria-hidden="true">
    <path d="M12 0 C4 8, 4 16, 12 22" fill="none" stroke="#7a6a4a" stroke-width="1.5" />
    <circle cx="12" cy="24" r="3.4" fill="none" stroke="#0c1b52" stroke-width="1.5" />
  </svg>
  <span class="kraft-tag__label">{text}</span>
</span>

<style>
  .kraft-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1rem 0.4rem 1.6rem;
    background: var(--color-kraft-dark);
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1;
    transform: rotate(-3deg);
    clip-path: polygon(10% 0%, 100% 0%, 100% 100%, 10% 100%, 0% 50%);
    box-shadow: 2px 3px 0 rgba(12, 27, 82, 0.1);
  }

  .kraft-tag__string {
    position: absolute;
    left: -10px;
    top: -26px;
    width: 20px;
    height: 34px;
  }

  .kraft-tag__label {
    padding-left: 0.35rem;
  }
</style>

---
import { locales, localeNames, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
interface Props { locale: Locale; page: 'home' | 'imprint' | 'privacy-policy'; }
const { locale, page } = Astro.props;
const hrefFor = (target: Locale) => page === 'home' ? `/${target}/` : `/${target}/${page}/`;
---
<details class="language-picker">
  <summary aria-label={`${t(locale, 'footer.language')}: ${localeNames[locale]}`}>{localeNames[locale]}</summary>
  <nav aria-label={t(locale, 'footer.language')}>
    {locales.map((code) => <a href={hrefFor(code)} lang={code} aria-current={code === locale ? 'true' : undefined}>{localeNames[code]}</a>)}
  </nav>
</details>
<script>
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const picker of document.querySelectorAll<HTMLDetailsElement>('.language-picker[open]')) {
      picker.open = false;
      picker.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    for (const picker of document.querySelectorAll<HTMLDetailsElement>('.language-picker[open]')) {
      if (!picker.contains(event.target as Node)) picker.open = false;
    }
  });
</script>

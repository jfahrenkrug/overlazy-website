---
interface Props {
  bandText: string;
  class?: string;
}

const { bandText, class: className = '' } = Astro.props;
---

<div class:list={['print-card', className]} aria-hidden="true">
  <div class="print-card__tape" />
  <div class="print-card__body">
    <svg
      class="print-card__scene"
      viewBox="0 0 300 300"
      preserveAspectRatio="xMidYMid slice"
      role="presentation"
    >
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fcebd9" />
          <stop offset="100%" stop-color="#fa5830" />
        </linearGradient>
      </defs>
      <rect width="300" height="300" fill="url(#sky)" />
      <circle cx="150" cy="120" r="34" fill="#fff8ec" />
      <path d="M-10 230 L70 150 L130 210 L190 130 L310 230 Z" fill="#fa5830" opacity="0.9" />
      <path d="M-10 260 L110 170 L190 240 L260 190 L310 260 L-10 300 Z" fill="#e8471f" />
    </svg>
    <div class="print-card__band">
      <svg class="print-card__spark" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 0 L14.2 9.8 L24 12 L14.2 14.2 L12 24 L9.8 14.2 L0 12 L9.8 9.8 Z"
          fill="#fcebd9"
        />
      </svg>
      <span class="print-card__band-text">{bandText}</span>
    </div>
  </div>
  <div class="print-card__peel">
    <span class="print-card__peel-shine" />
  </div>
</div>

<style>
  .print-card {
    --card-w: clamp(200px, 24vw, 280px);
    position: relative;
    width: var(--card-w);
    aspect-ratio: 2 / 3;
    transform: rotate(-4deg);
    filter: drop-shadow(14px 22px 26px rgba(12, 27, 82, 0.28));
  }

  @media (prefers-reduced-motion: no-preference) {
    .print-card {
      animation: print-card-settle 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    }

    .print-card__tape {
      animation: tape-press 0.45s ease-out 0.75s both;
    }

    .print-card__peel {
      animation: peel-lift 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.95s both;
    }
  }

  @keyframes print-card-settle {
    from {
      opacity: 0;
      transform: rotate(-12deg) translateY(-18px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: rotate(-4deg) translateY(0) scale(1);
    }
  }

  @keyframes tape-press {
    from {
      opacity: 0;
      transform: rotate(-30deg) translateY(-10px);
    }
    to {
      opacity: 1;
      transform: rotate(-18deg) translateY(0);
    }
  }

  @keyframes peel-lift {
    from {
      transform: rotate(0deg) translate(0, 0);
    }
    to {
      transform: rotate(-6deg) translate(2px, -3px);
    }
  }

  .print-card__body {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-paper);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    clip-path: polygon(
      0% 3%,
      2% 0%,
      98% 0%,
      100% 3%,
      100% 100%,
      82% 100%,
      82% 94%,
      100% 92%,
      100% 100%,
      0% 100%
    );
  }

  .print-card__scene {
    flex: 1;
    width: 100%;
    display: block;
  }

  .print-card__band {
    position: relative;
    background: var(--color-ink);
    padding: 0.65rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 22%;
  }

  .print-card__spark {
    width: clamp(14px, 2.2vw, 18px);
    height: clamp(14px, 2.2vw, 18px);
    flex-shrink: 0;
  }

  .print-card__band-text {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-cream);
    font-size: clamp(0.95rem, 2.6vw, 1.35rem);
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .print-card__peel {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 24%;
    height: 16%;
    background: linear-gradient(135deg, #ffffff 0%, #e7e2d6 55%, #cfc7b4 100%);
    clip-path: polygon(0% 100%, 100% 0%, 100% 100%);
    transform-origin: bottom right;
    transform: rotate(-6deg) translate(2px, -3px);
    box-shadow: -6px -6px 10px rgba(12, 27, 82, 0.18);
  }

  .print-card__peel-shine {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.55) 0px,
      rgba(255, 255, 255, 0.55) 2px,
      transparent 2px,
      transparent 6px
    );
    opacity: 0.5;
  }

  .print-card__tape {
    position: absolute;
    left: -8%;
    top: -7%;
    width: 40%;
    height: 13%;
    background: linear-gradient(
      100deg,
      rgba(252, 235, 217, 0.6),
      rgba(252, 235, 217, 0.88) 40%,
      rgba(252, 235, 217, 0.6)
    );
    border: 1px solid rgba(255, 255, 255, 0.4);
    transform: rotate(-18deg);
    clip-path: polygon(
      0% 15%,
      6% 0%,
      12% 20%,
      20% 2%,
      28% 22%,
      36% 0%,
      44% 18%,
      52% 2%,
      60% 20%,
      68% 0%,
      76% 18%,
      84% 2%,
      92% 20%,
      100% 4%,
      100% 88%,
      92% 100%,
      84% 82%,
      76% 100%,
      68% 84%,
      60% 100%,
      52% 82%,
      44% 100%,
      36% 84%,
      28% 100%,
      20% 82%,
      12% 100%,
      6% 84%,
      0% 100%
    );
    box-shadow: 0 3px 6px rgba(12, 27, 82, 0.12);
    z-index: 2;
  }
</style>

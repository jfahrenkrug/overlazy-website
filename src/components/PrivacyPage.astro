---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { privacy } from '../i18n/privacy';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<BaseLayout locale={locale} page="privacy-policy" title={`${t(locale, 'privacy.title')} — Overlazy`} description={t(locale, 'privacy.description')}>
  <div class="legal-page">
    <header class="legal-header"><a href={`/${locale}/`} class="brand">Overlazy</a></header>
    <main class="legal-copy">
      <h1>{t(locale, 'privacy.title')}</h1>
      <p><time datetime="2026-09-30">{t(locale, 'privacy.updated')}</time></p>
      {privacy[locale].map(([heading, body], index) => <section>
        <h2>{heading}</h2><p>{body}</p>
        {index === 2 && <p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub — Privacy Statement</a></p>}
        {index === 3 && <p><a href="mailto:johannes@springenwerk.com">johannes@springenwerk.com</a></p>}
      </section>)}
      <a class="back-link" href={`/${locale}/`}>{t(locale, 'imprint.back')}</a>
    </main>
    <Footer locale={locale} page="privacy-policy" />
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { locales } from '../../i18n/locales';
import { t } from '../../i18n/ui';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
---
<BaseLayout locale={locale} page="imprint" title={`${t(locale, 'imprint.title')} — Overlazy`} description={t(locale, 'imprint.title')}>
  <div class="legal-page">
    <header class="legal-header"><a href={`/${locale}/`} class="brand">Overlazy</a></header>
    <main class="legal-copy">
      <h1>{t(locale, 'imprint.heading')}</h1>
      <section><h2>{t(locale, 'imprint.responsible')}</h2><address>Johannes Fahrenkrug<br />Parkstraße 20<br />13585 Berlin, Germany</address></section>
      <section><h2>{t(locale, 'imprint.contact')}</h2><p><a href="mailto:johannes@springenwerk.com">johannes@springenwerk.com</a></p></section>
      <section><h2>{t(locale, 'imprint.vat')}</h2><p>DE355297606</p></section>
      <a class="back-link" href={`/${locale}/`}>{t(locale, 'imprint.back')}</a>
    </main>
    <Footer locale={locale} page="imprint" />
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguagePicker from '../../components/LanguagePicker.astro';
import { locales } from '../../i18n/locales';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="imprint"
  title={`${t(locale, 'imprint.title')} — Overlazy`}
  description={t(locale, 'imprint.title')}
>
  <div class="linen relative min-h-svh">
    <header class="relative z-40 mx-auto flex max-w-3xl items-center justify-between px-5 py-6 sm:px-8">
      <a href={`/${locale}/`} class="flex items-center gap-2.5">
        <img src="/images/app-icon.png" alt="" width="32" height="32" class="rounded-[9px] shadow-sm" />
        <span class="font-display text-lg font-extrabold tracking-tight text-ink">Overlazy</span>
      </a>
      <LanguagePicker locale={locale} page="imprint" />
    </header>

    <main class="relative z-10 mx-auto max-w-3xl px-5 pb-20 pt-6 sm:px-8">
      <div class="rounded-3xl border-2 border-ink/10 bg-paper px-6 py-8 shadow-[6px_6px_0_0_rgba(12,27,82,0.06)] sm:px-10 sm:py-12">
        <h1 class="font-display text-3xl font-extrabold text-ink sm:text-4xl">{t(locale, 'imprint.heading')}</h1>

        <div class="mt-8 space-y-6 text-ink-soft">
          <div>
            <p class="font-semibold text-ink">{t(locale, 'imprint.responsible')}</p>
            <p class="mt-1">Johannes Fahrenkrug</p>
            <p>Parkstraße 20</p>
            <p>13585 Berlin, Germany</p>
          </div>

          <div>
            <p class="font-semibold text-ink">{t(locale, 'imprint.contact')}</p>
            <p class="mt-1">
              Email: <a class="underline decoration-ink-soft/30 underline-offset-4 hover:text-ink" href="mailto:johannes@springenwerk.com">johannes@springenwerk.com</a>
            </p>
          </div>

          <div>
            <p class="font-semibold text-ink">{t(locale, 'imprint.vat')}</p>
            <p class="mt-1">DE355297606</p>
          </div>
        </div>

        <a
          href={`/${locale}/`}
          class="mt-10 inline-flex items-center gap-2 font-body text-sm font-semibold text-flame-deep hover:text-ink"
        >
          ← {t(locale, 'imprint.back')}
        </a>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .linen {
    background-color: var(--color-kraft);
    background-image:
      radial-gradient(circle at 1px 1px, rgba(12, 27, 82, 0.055) 1px, transparent 0);
    background-size: 14px 14px;
  }
</style>

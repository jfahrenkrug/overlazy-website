---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { locales } from '../../i18n/locales';
import { t } from '../../i18n/ui';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
---
<BaseLayout locale={locale} page="home" title={t(locale, 'meta.title')} description={t(locale, 'meta.description')}>
  <div class="landing">
    <main class="wordmark"><h1>Overlazy</h1></main>
    <Footer locale={locale} page="home" />
  </div>
</BaseLayout>
